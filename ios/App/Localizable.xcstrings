    "Activités en direct désactivées : activez-les dans les réglages de Réveil VIA pour afficher le réveil sur l’écran verrouillé.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activités en direct désactivées : activez-les dans les réglages de Réveil VIA pour afficher le réveil sur l’écran verrouillé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are disabled. Enable them in VIA Wake’s settings to show the alarm on your Lock Screen."
          }
        }
      }
    },
    "Affichage sur l’écran verrouillé indisponible. Rouvrez l’app pour réessayer; le réveil reste programmé.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage sur l’écran verrouillé indisponible. Rouvrez l’app pour réessayer; le réveil reste programmé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Screen display is unavailable. Reopen the app to try again; your alarm remains scheduled."
          }
        }
      }
